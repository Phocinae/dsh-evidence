{
  "name": "dsh-preclaim",
  "description": "DeepSeek Harness plugin: a deterministic gate that checks a git commit, push or README write asserting something was verified against what the session actually ran. No model, no network.",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phocinae/dsh-evidence.git"
  },
  "homepage": "https://github.com/Phocinae/dsh-evidence#readme",
  "bugs": {
    "url": "https://github.com/Phocinae/dsh-evidence/issues"
  },
  "author": "PerryLink",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./lib/ledger.mjs": "./lib/ledger.mjs",
    "./lib/gate.mjs": "./lib/gate.mjs",
    "./lib/constants.mjs": "./lib/constants.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "tools.mjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "preclaim",
    "evidence",
    "verification",
    "fail-closed",
    "deterministic",
    "no-network",
    "phocinae"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-0 <0.2.0 || >=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
